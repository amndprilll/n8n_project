    {
      "parameters": {
        "jsCode": "const input = items[0].json;\nconst rawOutput = input.output || \"\";\n\nlet isTicket = false;\nlet email = \"\", kategori = \"\", deskripsi = \"\";\nlet finalOutput = rawOutput;\n\nif (rawOutput.includes(\"[BUAT_TIKET]\")) {\n    isTicket = true;\n    try {\n        const partsToExtract = rawOutput.split(\"[BUAT_TIKET]\");\n        const aiResponse = partsToExtract[0].trim();\n        const str = partsToExtract[1].trim();\n        const parts = str.split(\"|\").map(s => s.trim());\n        email = parts[0] || \"Unknown\";\n        kategori = parts[1] || \"General\";\n        deskripsi = parts[2] || \"No description\";\n        finalOutput = `${aiResponse}\\n\\n🎫 *(Sistem: Tiket laporan \"${kategori}\" telah berhasil dicatat ke Spreadsheet)*`;\n    } catch(e) {}\n} else if (rawOutput.includes(\"[ESKALASI_HR]\")) {\n    const aiResponse = rawOutput.split(\"[ESKALASI_HR]\")[0].trim();\n    finalOutput = `${aiResponse}\\n\\n🚨 *(Sistem: Pesan telah dieskalasi ke tim HR)*`;\n} else if (input.Nama && input['Gaji Pokok']) {\n    finalOutput = `*SLIP GAJI KARYAWAN*\\nNama: ${input.Nama}\\nJabatan: ${input.Jabatan}\\n\\nGaji Pokok: Rp ${Number(input['Gaji Pokok']).toLocaleString('id-ID')}\\nBPJS: Rp ${Number(input['BPJS']||0).toLocaleString('id-ID')}\\nPajak: Rp ${Number(input['Pajak']||0).toLocaleString('id-ID')}\\nBonus: Rp ${Number(input['Bonus']||0).toLocaleString('id-ID')}\\n\\nTOTAL BERSIH: Rp ${Number(input['Gaji Bersih']).toLocaleString('id-ID')}`;\n}\n\nreturn [{\n    json: {\n        isTicket: isTicket,\n        email: email,\n        kategori: kategori,\n        deskripsi: deskripsi,\n        output: finalOutput.replace(/[*_`[\\]()|]/g, '')\n    }\n}];"
      },
